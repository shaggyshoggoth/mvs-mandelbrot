PRTMAND  START
.* Prints the mandelbrot set
.*
         USING *,12                Setup data offsets
         SAVE  (14,12)
         LR    12,15
         LA    2,SAVEAREA
         ST    2,8(,13)
         ST    13,SAVEAREA+4
         LR    13,2
         OPEN  (PRINTER,(OUTPUT))
         CRDINIT XTRAN             Initialize coordinate translation
         CRDINIT YTRAN
XLOOP    LD    0,YCRNT             Coordinate translate
         CRDTRAN YTRAN
         LDR   4,0
         LD    0,XCRNT
         CRDTRAN XTRAN
         LDR   2,4                 Setup inputs
         L     4,MAXITER
         MANDEL DMB                Calculate if in set
         BE    NOPRINT
         IC    1,HASH              Inline PUTC macro
         L     2,XCHAR
         STC   1,PRTBUF+1(2)       Byte 0 is carriage control
         B     CONT
NOPRINT  IC    1,SPACE             Inline PUTC macro
         L     2,XCHAR
         STC   1,PRTBUF+1(2)
CONT     L     0,XCHAR
         A     0,ONE
         ST    0,XCHAR
         C     0,=F'120'           End of row?
         BNL   YNEXT
         LD    0,XCRNT
         AD    0,ONED
         STD   0,XCRNT
         B     XLOOP
YNEXT    PUT   PRINTER,PRTBUF
         L     0,ZERO
         ST    0,XCHAR
         LD    0,ZEROD
         STD   0,XCRNT
         LD    0,YCRNT
         AD    0,ONED
         STD   0,YCRNT
         CD    0,=D'61'            Last row?
         BL    XLOOP
DONE     CLOSE (PRINTER)
         L     13,SAVEAREA+4       Restore caller's save area
         RETURN (14,12),RC=0
XTRAN    DC    D'0',D'120',D'-2.1',D'0.6'
YTRAN    DC    D'0',D'60',D'-1.125',D'1.125'
XCRNT    DC    D'0.0'
YCRNT    DC    D'0.0'
ONED     DC    D'1.0'
ZEROD    DC    D'0.0'
XCHAR    DC    F'0'
ONE      DC    F'1'
ZERO     DC    F'0'
MAXITER  DC    F'100'
SPACE    DC    C'    '
HASH     DC    C'####'
DMB      DMAND
SAVEAREA DS    18F
PRTBUF   DC    X'09',120C' '      Machine CC: write, space 1
PRINTER  DCB   DSORG=PS,                                               X
               MACRF=(PM),                                             X
               DEVD=DA,                                                X
               DDNAME=SYSLOUT,                                         X
               RECFM=FM,                                               X
               LRECL=121
         END   PRTMAND
